{
  "name": "HUMAIN Incident Commander",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt -r requirements-eval.txt",
  "postAttachCommand": "python console/app.py",
  "forwardPorts": [8088],
  "portsAttributes": {
    "8088": {
      "label": "Incident console",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
