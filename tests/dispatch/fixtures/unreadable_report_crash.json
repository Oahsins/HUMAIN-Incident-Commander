{
 "describe": {
  "system": "dispatch",
  "contract_version": 1,
  "capabilities": {
   "probe": true,
   "act": true,
   "changes": true,
   "baseline": "warmup",
   "max_mode": "auto",
   "min_window_s": 2
  },
  "journeys": [
   {
    "name": "emergency_call",
    "default": true,
    "entry": "call-handling",
    "slo": {
     "success_rate": 0.99,
     "p95_ms": 1000
    },
    "side_effects": "test_data",
    "description": "a 9-1-1 caller is answered, gives the location and the emergency, is told help is on the way, and a crew is en route soon after"
   }
  ],
  "slo": {
   "success_rate": 0.99,
   "p95_ms": 1000
  },
  "components": [
   {
    "name": "call-handling",
    "kind": "service",
    "depends_on": [
     "call-network",
     "cad"
    ],
    "impact_weight": 1.0,
    "actions": [
     "restart",
     "rollback",
     "revert_config"
    ],
    "description": "9-1-1 call handling: queues each 9-1-1 call for the call-taker positions, gets the caller's location from the call network, and enters the incident in CAD",
    "standby": null
   },
   {
    "name": "cad",
    "kind": "service",
    "depends_on": [
     "cad-db"
    ],
    "impact_weight": 1.0,
    "actions": [
     "restart",
     "rollback",
     "revert_config"
    ],
    "description": "computer-aided dispatch server: creates incidents from calls, links a repeat call from the same number to its open incident, and takes in status reports from unit terminals",
    "standby": null
   },
   {
    "name": "dispatcher",
    "kind": "worker",
    "depends_on": [
     "cad-db",
     "alerting"
    ],
    "impact_weight": 1.0,
    "actions": [
     "restart",
     "rollback",
     "revert_config"
    ],
    "description": "automated dispatch: takes pending incidents in priority order, recommends the closest free unit, commits it and sends the station alert",
    "standby": null
   },
   {
    "name": "alerting",
    "kind": "dependency",
    "depends_on": [],
    "impact_weight": 1.0,
    "actions": [
     "restart",
     "failover"
    ],
    "description": "station alerting controller: alerts the unit's station over the county network",
    "standby": "alerting-backup"
   },
   {
    "name": "alerting-backup",
    "kind": "dependency",
    "depends_on": [],
    "impact_weight": 0.0,
    "actions": [
     "restart"
    ],
    "description": "backup station alerting over the radio tone path; carries alerts only after a failover",
    "standby": null
   },
   {
    "name": "unit-sync",
    "kind": "worker",
    "depends_on": [
     "cad-db"
    ],
    "impact_weight": 0.6,
    "actions": [
     "restart",
     "rollback",
     "revert_config",
     "quarantine"
    ],
    "description": "unit status interface: applies status reports from unit terminals to CAD's unit records",
    "standby": null
   },
   {
    "name": "call-network",
    "kind": "external",
    "depends_on": [],
    "impact_weight": 0.5,
    "actions": [],
    "description": "the 9-1-1 call network provider's location service (ALI), run by another organisation; we cannot change it",
    "standby": null
   },
   {
    "name": "cad-db",
    "kind": "datastore",
    "depends_on": [],
    "impact_weight": 1.0,
    "actions": [
     "release_lock"
    ],
    "description": "the CAD database (SQLite): incidents, calls, units, assignments and the queue of reports from unit terminals",
    "standby": null
   },
   {
    "name": "incident-archive",
    "kind": "job",
    "depends_on": [
     "cad-db"
    ],
    "impact_weight": 0.0,
    "actions": [],
    "description": "export of closed incidents to the records system; normal when not running",
    "standby": null
   }
  ],
  "actions": {
   "restart": {
    "est_seconds": 3,
    "undo": null,
    "params": {},
    "description": "restart the component's process; work in progress is dropped: on call-handling, calls being answered are cut off and the callers must redial"
   },
   "rollback": {
    "est_seconds": 4,
    "undo": "deploy the newer release again",
    "params": {},
    "description": "return the component to its previous release"
   },
   "revert_config": {
    "est_seconds": 1,
    "undo": "set the value again",
    "params": {
     "key": {
      "optional": true,
      "description": "the setting to undo; default: the newest change not made by the incident commander"
     }
    },
    "description": "undo one setting change on the component"
   },
   "release_lock": {
    "est_seconds": 1,
    "undo": null,
    "params": {},
    "description": "end the session holding the datastore lock; its unfinished transaction rolls back"
   },
   "failover": {
    "est_seconds": 1,
    "undo": "fail over again with to=primary",
    "params": {
     "to": {
      "enum": [
       "standby",
       "primary"
      ]
     }
    },
    "description": "switch the component's callers to its standby, or back to the primary"
   },
   "quarantine": {
    "est_seconds": 1,
    "undo": "operations can put the item back",
    "params": {
     "item": {
      "from": "extra.head_item.id"
     }
    },
    "description": "set one queued field report aside so unit-sync skips it; the unit's next report repeats its state"
   }
  },
  "forbidden": [
   "close or cancel an incident",
   "change a call's priority",
   "stand down or reassign a unit committed to an incident",
   "contact a caller"
  ],
  "escalation_contacts": [
   {
    "role": "shift supervisor",
    "for": [
     "call-handling",
     "dispatcher"
    ]
   },
   {
    "role": "CAD administrator",
    "for": [
     "cad",
     "cad-db",
     "unit-sync",
     "incident-archive"
    ]
   },
   {
    "role": "radio and alerting technician",
    "for": [
     "alerting",
     "alerting-backup"
    ]
   },
   {
    "role": "call network provider",
    "for": [
     "call-network"
    ]
   }
  ]
 },
